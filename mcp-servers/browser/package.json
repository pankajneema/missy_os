{
  "name": "missy-browser-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets Missy use a web browser, subject to the site permissions set in the app.",
  "bin": { "missy-browser-mcp": "src/index.js" },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "check": "node --check src/index.js && node src/policy.test.js",
    "install-browser": "playwright install chromium"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "playwright": "^1.49.0"
  }
}
