DATABASE_URL=postgresql+psycopg2://missy:missy@localhost:5439/missy_os
JWT_SECRET_KEY=changeme-generate-a-real-random-secret
FERNET_KEY=changeme-generate-with-python--c-"from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ALLOWED_ORIGINS=["http://localhost:8501"]

# Off by default - a local (stdio) MCP server runs an arbitrary command with
# this backend's own OS privileges on behalf of whichever account configures
# it, not just yours. Only set this to true if every account that can log in
# is already fully trusted with that.
ALLOW_MCP_STDIO_SERVERS=false

# Optional - LangSmith tracing (smith.langchain.com). Leave blank to disable;
# every chat/tool/graph call already runs through LangChain's Runnable
# interface, so setting this key is the only step needed to turn tracing on.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=missy-os
